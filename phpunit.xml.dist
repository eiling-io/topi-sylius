<?xml version="1.0" encoding="UTF-8"?>
<!--
    Minimal PHPUnit config for the plugin's own tests/Unit suite — pure unit tests
    with no Symfony kernel/DB involved, so this deliberately stays lightweight rather
    than pulling in the bootstrap machinery tests/Functional and tests/Integration
    will eventually need against tests/TestApplication.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
