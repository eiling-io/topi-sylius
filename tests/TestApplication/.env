DATABASE_URL=mysql://root:root@db/sylius_topi_plugin_%kernel.environment%

BEHAT_BASE_URL="http://127.0.0.1:8080/"

SYLIUS_TEST_APP_BUNDLES_PATH="tests/TestApplication/config/bundles.php"
SYLIUS_TEST_APP_CONFIGS_TO_IMPORT="@EilingIoSyliusTopiPlugin/tests/TestApplication/config/config.yaml"
SYLIUS_TEST_APP_ROUTES_TO_IMPORT="@EilingIoSyliusTopiPlugin/tests/TestApplication/config/routes.yaml"

# Sandbox credentials for the Topi seller API (identity.topi-sandbox.eu). Leave
# TOPI_ENABLE_LIVE=0 for the test environment — it points GuzzleClientFactory at
# Topi's sandbox instead of production.
# Put real values in a gitignored tests/TestApplication/.env.local, not here.
TOPI_CLIENT_ID=""
TOPI_CLIENT_SECRET=""
TOPI_WIDGET_ID=""
TOPI_ENABLE_LIVE=0

# Comma-separated Svix signing secrets from the Topi merchant portal's webhook
# settings. Signature checks can be disabled while wiring things up locally.
TOPI_WEBHOOK_SIGNING_SECRETS=""
TOPI_ENABLE_WEBHOOK_SIGNATURE_CHECKS=0

# Feature flag consumed by TopiProductExtension's is_topi_product()/topi_pdp_item().
TOPI_ENABLE=1
